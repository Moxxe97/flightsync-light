<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Everything is backed up and moved to a new phone EXCEPT the
     encrypted sign-in token (KeystorePlugin): it cannot be decrypted without
     this device's Keystore key, and a copy restored on another phone used to
     break sign-in, sign-out and backups. The pilot simply signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fsl-secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fsl-secure.xml" />
    </device-transfer>
</data-extraction-rules>
